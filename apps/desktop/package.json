{
  "name": "vibe-teamlead-desktop",
  "productName": "Vibe Teamlead",
  "version": "2.0.0-beta.37",
  "type": "module",
  "description": "Vibe Teamlead — a team of Claude Code agents that builds software from a spec",
  "homepage": "https://github.com/KolyaSotnichenko/vibe-teamlead",
  "repository": {
    "type": "git",
    "url": "https://github.com/KolyaSotnichenko/vibe-teamlead.git"
  },
  "main": "./out/main/index.js",
  "author": {
    "name": "Mykola Sotnichenko"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "node scripts/build-preview-assets.mjs && electron-vite dev",
    "dev:debug": "node scripts/build-preview-assets.mjs && cross-env DEBUG=true electron-vite dev",
    "dev:mcp": "electron-vite dev -- --remote-debugging-port=9222",
    "build": "electron-vite build && node scripts/check-main-bundle.mjs && node scripts/build-preview-assets.mjs",
    "start": "electron .",
    "start:mcp": "electron . --remote-debugging-port=9222",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild",
    "package": "npm run build && node scripts/fetch-scanners.cjs && electron-builder",
    "package:mac": "npm run build && node scripts/fetch-scanners.cjs && electron-builder --mac",
    "start:packaged:mac": "open 'dist/mac-arm64/Vibe Teamlead.app' || open 'dist/mac/Vibe Teamlead.app'",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/__tests__/integration/ --exclude src/__tests__/e2e/",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit --incremental"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.42",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/mcp": "^1.0.25",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@anthropic-ai/claude-agent-sdk": "0.3.317",
    "@anthropic-ai/sdk": "^1.4.0",
    "@colbymchenry/codegraph": "1.6.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@libsql/client": "^0.17.0",
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@playwright/mcp": "0.0.83",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/electron": "^7.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.13.22",
    "@tavily/core": "^0.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "ai": "^6.0.116",
    "chokidar": "^5.0.0",
    "chrome-devtools-mcp": "1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "i18next": "^25.8.18",
    "js-yaml": "^4.1.1",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "minimatch": "^10.2.4",
    "motion": "^12.36.0",
    "proper-lockfile": "^4.1.2",
    "pyright": "^1.1.414",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.7.4",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.3",
    "uuid": "^13.0.0",
    "web-tree-sitter": "^0.26.7",
    "xstate": "^5.28.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.3",
    "@medv/finder": "4.0.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "electron": "40.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "react-grab": "0.2.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.2.7",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "electron-builder-squirrel-windows": "^26.0.12",
    "dmg-builder": "^26.0.12",
    "@electron/rebuild": "4.0.3"
  },
  "build": {
    "appId": "com.vibeteamlead.app",
    "productName": "Vibe Teamlead",
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${platform}-${arch}.${ext}",
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "KolyaSotnichenko",
        "repo": "vibe-teamlead"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/node_modules/@colbymchenry/codegraph-*/**"
    ],
    "asarUnpack": [
      "out/main/node_modules/@lydell/node-pty-*/**"
    ],
    "extraResources": [
      {
        "from": "prompts",
        "to": "prompts"
      },
      {
        "from": "../../node_modules/@libsql",
        "to": "node_modules/@libsql"
      },
      {
        "from": "../../node_modules/libsql",
        "to": "node_modules/libsql"
      },
      {
        "from": "../../node_modules/@neon-rs",
        "to": "node_modules/@neon-rs"
      },
      {
        "from": "../../node_modules/detect-libc",
        "to": "node_modules/detect-libc"
      },
      {
        "from": "vendor/superpowers",
        "to": "plugins/superpowers"
      },
      {
        "from": "vendor/drawio",
        "to": "plugins/drawio"
      },
      {
        "from": "vendor/vibe-teamlead-skills",
        "to": "plugins/vibe-teamlead-skills"
      },
      {
        "from": "vendor/frontend-design",
        "to": "plugins/frontend-design"
      },
      {
        "from": "vendor/ux-review",
        "to": "plugins/ux-review"
      },
      {
        "from": "vendor/gsap-skills",
        "to": "plugins/gsap-skills"
      },
      {
        "from": "vendor/drawio-viewer",
        "to": "drawio-viewer"
      },
      {
        "from": "../../node_modules/mermaid/dist",
        "to": "mermaid",
        "filter": [
          "mermaid.min.js"
        ]
      },
      {
        "from": "vendor-bin",
        "to": "scanners",
        "filter": [
          "gitleaks",
          "osv-scanner"
        ]
      },
      {
        "from": "../../node_modules/@playwright/mcp",
        "to": "browser-mcp/node_modules/@playwright/mcp"
      },
      {
        "from": "../../node_modules/@playwright/mcp/node_modules/playwright",
        "to": "browser-mcp/node_modules/playwright"
      },
      {
        "from": "../../node_modules/@playwright/mcp/node_modules/playwright-core",
        "to": "browser-mcp/node_modules/playwright-core"
      },
      {
        "from": "../../node_modules/chrome-devtools-mcp",
        "to": "browser-mcp/node_modules/chrome-devtools-mcp"
      },
      {
        "from": "../../node_modules/typescript-language-server",
        "to": "lsp/node_modules/typescript-language-server",
        "filter": [
          "lib/cli.mjs",
          "package.json",
          "LICENSE*"
        ]
      },
      {
        "from": "../../node_modules/typescript",
        "to": "lsp/node_modules/typescript",
        "filter": [
          "lib/**",
          "package.json",
          "LICENSE.txt"
        ]
      },
      {
        "from": "../../node_modules/pyright",
        "to": "lsp/node_modules/pyright",
        "filter": [
          "dist/**",
          "index.js",
          "langserver.index.js",
          "package.json",
          "LICENSE.txt"
        ]
      },
      {
        "from": "../../node_modules/@anthropic-ai/claude-agent-sdk-darwin-${arch}/claude",
        "to": "claude-code/claude"
      },
      {
        "from": "../../node_modules/@colbymchenry/codegraph-darwin-${arch}",
        "to": "codegraph",
        "filter": [
          "bin/**",
          "lib/**",
          "node",
          "package.json",
          "LICENSE*"
        ]
      }
    ],
    "afterAllArtifactBuild": "scripts/verify-dmg.cjs",
    "dmg": {
      "size": "4g"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
